            for tool in get_selected_tools()
            if has_penalty_sweep(tool)
            for penalty in get_penalty_values(tool)
        ] if "external" in config.get("data_types", []) else [],
        # Real-sample tool results (data_type == "realsim", rep always 0, no ground truth
