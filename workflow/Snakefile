    try:
        samples_table = pd.read_csv(
            config["samples_file"],
            header=0,
            index_col=0,
            comment="#",
            engine="python",
            sep="\t",
        )
        # Check if table has any rows (excluding header)
        if len(samples_table) > 0:
            has_samples = True
            logger.info(f"Loaded samples table with {len(samples_table)} samples")
        else:
            logger.info("Samples table is empty - skipping sample analysis")
    except Exception as e:
        logger.warning(f"Could not load samples table: {e}")
