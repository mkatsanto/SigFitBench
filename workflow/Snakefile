# Load sample table if it exists and is populated
samples_table = pd.DataFrame()
has_samples = False

if "samples_file" in config and os.path.exists(config["samples_file"]):
    try:
        samples_table = pd.read_csv(
            config["samples_file"],
            header=0,
            index_col=0,
            comment="#",
            engine="python",
            sep="\t",
        )
        # Check if table has any rows (excluding header)
        if len(samples_table) > 0:
            has_samples = True
            logger.info(f"Loaded samples table with {len(samples_table)} samples")
        else:
            logger.info("Samples table is empty - skipping sample analysis")
    except Exception as e:
        logger.warning(f"Could not load samples table: {e}")
else:
    logger.info("No samples file configured - skipping sample analysis")

# Final target rule: collect all workflow outputs
rule all:
    """
    Target rule that expands all wildcard combinations for complete analysis.
    Includes tool fitting results and comprehensive evaluation metrics.
    Wildcards are used in individual rules, expanded only here.
    Conditionally includes sample analysis if samples.tsv is populated.
    Conditionally includes bootstrap quality assessment if enabled in config.
    """
    input:
        # Tool fitting outputs (data generation + tool execution)
        # Exclude methods with penalty sweeps - they create penalty-specific files
        tool_results = expand(
            os.path.join(
                config['output_dir'],
                "{data_type}",
                "{cancer_type}",
                "{relevance}",
                "{identifier}",
                "rep_{rep}",
                "{tool}_contribution.dat"
            ),
            data_type=active_data_types,
            cancer_type=config.get("cancer_types", ["Head-SCC"]),
            identifier=config["num_muts"],
            relevance=config.get("relevance_modes", ["standard", "relevant"]),
            tool=[t for t in get_selected_tools() if not has_penalty_sweep(t)],
