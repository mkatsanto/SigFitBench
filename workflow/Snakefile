from snakemake.utils import validate


def fix_macos_benchmark_memory():
    """Let benchmark: record max_rss/max_vms on macOS (uss, pss and io stay 0)."""
    import collections
    import psutil

    MemoryInfo = collections.namedtuple(
        "MemoryInfo", ["rss", "vms", "pfaults", "pageins", "uss", "pss"])

    def memory_info_with_pss(process):
        memory = process.memory_info()
        return MemoryInfo(*memory, uss=0, pss=0)

    def io_counters_not_available(process):
        raise NotImplementedError

    psutil.Process.memory_full_info = memory_info_with_pss
    psutil.Process.io_counters = io_counters_not_available

if sys.platform == "darwin":  # "darwin" = macOS
    fix_macos_benchmark_memory()


configfile: os.path.join(workflow.basedir, "..", "config", "config.yaml")

# Expand {output_dir} placeholders in config
def expand_output_dir_in_dict(d, output_dir):
    """Recursively expand {output_dir} placeholders in dictionary values"""
    if isinstance(d, dict):
        return {k: expand_output_dir_in_dict(v, output_dir) for k, v in d.items()}
    elif isinstance(d, list):
        return [expand_output_dir_in_dict(item, output_dir) for item in d]
    elif isinstance(d, str) and "{output_dir}" in d:
        return d.format(output_dir=output_dir)
    else:
        return d

